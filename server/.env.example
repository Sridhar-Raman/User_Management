# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=5001

# MongoDB connection string (local, or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/SyncNode

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Browser origin(s) allowed by CORS. In production set your Vercel URL, e.g.
# https://your-app.vercel.app  (several can be comma-separated, no trailing slash needed)
FRONTEND_URL=http://localhost:5173

# Used only by `node seed.js` to create the first admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# Sends "forgot password" reset emails via Brevo's SMTP relay.
# Find these at https://app.brevo.com -> Settings (gear icon) -> SMTP & API -> SMTP tab.
# BREVO_SMTP_LOGIN is the "Login" value shown there (an @smtp-brevo.com address,
# not your account email). BREVO_SMTP_KEY is the SMTP key/password (generate
# one if none is shown). BREVO_SENDER_EMAIL must be a sender you've verified
# in Brevo (Senders & IP -> Senders); it defaults to BREVO_SMTP_LOGIN if unset.
# If BREVO_SMTP_LOGIN/BREVO_SMTP_KEY are left blank, reset links are only
# logged to the server console.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SRI.CR
